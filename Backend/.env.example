PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
JWT_SECRET=change-this-secret-in-production

# Optional PostgreSQL target for the schema in DataBase/esquema.sql.
# The current development adapter persists records in Backend/data/flygo-db.json.
DATABASE_URL=postgres://user:password@localhost:5432/flygo

# Gemini AI
GEMINI_API_KEY=

# PayPal Checkout
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=

# Gmail API. Requiere un OAuth access token con permiso gmail.send.
GMAIL_ACCESS_TOKEN=
GMAIL_SENDER=me
